<Project Sdk="Cosmos.Sdk/3.0.97">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="Cosmos.Kernel" Version="3.0.97" />
    <PackageReference Include="Cosmos.Kernel.System" Version="3.0.97" />
    <PackageReference Include="Cosmos.Network.Telnet" Version="1.0.0" />
    <PackageReference Include="YesNt.Interpreter" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemSox.Shared\RemSox.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DejaVu Sans Mono, the UI font (free license: Resources/Fonts/DejaVu-LICENSE.txt). -->
    <EmbeddedResource Include="Resources\Fonts\DejaVuSansMono.ttf" LogicalName="DejaVuSansMono.ttf" />
    <!-- The cursor set, copied to /system/cursors at boot: Bibata Modern Ice (GPL-3.0:
         Resources/Cursors/Bibata-LICENSE.txt), made into .cur files by tools/make_cursors.py. -->
    <EmbeddedResource Include="Resources\Cursors\*.cur" LogicalName="Cursors.%(Filename)%(Extension)" />
    <!-- The default desktop background and lock screen, copied to /system/wallpapers at boot
         (drawn by tools/make_wallpapers.py). -->
    <EmbeddedResource Include="Resources\Wallpapers\*.qoi" LogicalName="Wallpapers.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
