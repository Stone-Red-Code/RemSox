# timer.ynt - a focus timer: name a task, pick a length, start, pause, reset.
# It waits for the user with ui_wait, so it costs nothing while nobody does anything.
# Every window statement that makes something gives its id through %out.

global running = False
global left = 0
global length = 0
global ends = 0
global sessions = 0
global task = nothing

win_create 420 300 Focus Timer
global win = %out
win_autoflush ${win} True
win_keep_open ${win} True

ui_label ${win} 20 46 "Task:"
ui_textbox ${win} 90 40 310 28
global name = %out
ui_label ${win} 20 86 Length: 20 s
global lengthlabel = %out
ui_slider ${win} 150 86 250 20 5 60
global slider = %out
ui_set ${slider} 20
ui_progressbar ${win} 20 124 380 18
global bar = %out
ui_label ${win} 20 156
global clock = %out
ui_font_size ${clock} 22
ui_label ${win} 20 190 Ready: name a task and press Start.
global status = %out
ui_font_size ${status} 14
ui_label ${win} 20 212 Sessions done: 0
global log = %out
ui_font_size ${log} 14
ui_button ${win} 20 248 86 32 Start
global start = %out
ui_button ${win} 116 248 86 32 Pause
global pause = %out
ui_button ${win} 212 248 86 32 Reset
global reset = %out
ui_button ${win} 314 248 86 32 Quit
global quit = %out

label events:
    if ${running} == True:
        ui_wait 250
    else:
        ui_wait
    end_if
    var fired = %out
    ui_get ${slider}
    ui_set ${lengthlabel} Length: %out s
    if ${fired} == ${quit} goto done
    if ${fired} == ${win} goto done
    if ${fired} == ${start} call start_task
    if ${fired} == ${name} call start_task
    if ${fired} == ${pause} call pause_task
    if ${fired} == ${reset} call reset_task
    if ${running} == True call tick
    goto events

label done:
win_close ${win}
print_line Bye: ${sessions} sessions done.
exit

func start_task:
    if ${running} == True:
        return
    end_if
    ui_get ${name}
    global task = %out
    length ${task}
    var size = %out
    if ${size} == 0:
        ui_set ${status} Name the task first.
        return
    end_if
    ui_get ${slider}
    global length = %out
    global ends = %time + ${length} calc
    global running = True
    ui_set ${pause} Pause
    ui_set ${status} Focusing on: ${task}
    call tick
end_func

func pause_task:
    if ${running} == True:
        global left = ${ends} - %time calc
        global running = False
        ui_set ${pause} Resume
        ui_set ${status} Paused: ${task}
        return
    end_if
    if ${left} > 0:
        global ends = %time + ${left} calc
        global left = 0
        global running = True
        ui_set ${pause} Pause
        ui_set ${status} Focusing on: ${task}
    end_if
end_func

func reset_task:
    global running = False
    global left = 0
    ui_set ${bar} 0
    ui_set ${clock}
    ui_set ${pause} Pause
    ui_set ${status} Ready: name a task and press Start.
end_func

func tick:
    var remaining = ${ends} - %time calc
    if ${remaining} <= 0:
        call finish
        return
    end_if
    var done = (${length} - ${remaining}) * 100 / ${length} calc
    ui_set ${bar} ${done}
    ui_set ${clock} ${remaining} s left
end_func

func finish:
    global running = False
    global sessions = ${sessions} + 1 calc
    ui_set ${bar} 100
    ui_set ${clock} Done!
    ui_set ${status} Finished: ${task}
    ui_set ${log} Sessions done: ${sessions}
end_func
