# focus.ynt - an animated window: a countdown, a progress bar and a moving dot, updated
# every 100 ms with sleep. The label and the bar change with ui_set, the dot moves with
# ui_move. timer.ynt is the interactive version.

global seconds = 20
global step = 0
global steps = ${seconds} * 10 calc
global bx = 30
global dx = 6

win_create 380 240 Focus Timer
global win = %out
win_autoflush ${win} True

ui_label ${win} 20 44 Focus session
ui_font_size %out 20
ui_label ${win} 20 72 Stay on one thing until the bar is full.
ui_font_size %out 14
ui_progressbar ${win} 20 150 340 18
global bar = %out
ui_label ${win} 20 112 "Time left:"
ui_font_size %out 18
ui_label ${win} 130 112 ${seconds}s
global left = %out
ui_font_size ${left} 18
ui_circle ${win} ${bx} 196 8
global dot = %out
ui_color ${dot} 80 160 255
ui_filled ${dot} True
ui_button ${win} 260 104 100 28 Running
print_line Focus timer started: ${seconds} s.

while ${step} < ${steps}:
    sleep 100
    global step = ${step} + 1 calc
    call move_dot
    global tenth = ${step} % 10 calc
    if ${tenth} == 0 call each_second
end_while

ui_remove ${dot}
ui_label ${win} 120 188 Done!
ui_font_size %out 22
print_line Session done.
sleep 3000
win_close ${win}
exit

func move_dot:
    global bx = ${bx} + ${dx} calc
    if ${bx} > 350 call bounce
    if ${bx} < 30 call bounce
    ui_move ${dot} ${bx} 196
end_func

func bounce:
    global dx = 0 - ${dx} calc
end_func

func each_second:
    global percent = ${step} * 100 / ${steps} calc
    global remaining = ${seconds} - ${step} / 10 calc
    ui_set ${bar} ${percent}
    ui_set ${left} ${remaining}s
end_func
