<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemSox.Shared\RemSox.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The kernel's UI font, so remote text looks like the local display. -->
    <EmbeddedResource Include="..\RemSox.Kernel\Resources\Fonts\DejaVuSansMono.ttf" LogicalName="DejaVuSansMono.ttf" />
  </ItemGroup>
</Project>
